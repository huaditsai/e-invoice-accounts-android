<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape>
            <solid 
                android:color="#556B2F" />
            <stroke
                android:width="1dp"
                android:color="#556B2F" />
            <corners
                android:radius="10dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid 
                android:color="#006400" />
            <stroke
                android:width="1dp"
                android:color="#006400" />
            <corners 
                android:radius="10dp" />
        </shape>
    </item>
</selector>